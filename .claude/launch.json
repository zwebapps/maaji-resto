{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maaji-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "-p", "3200"],
      "port": 3200,
      "autoPort": false
    },
    {
      "name": "maaji-mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "EXPO_PUBLIC_API_URL=http://localhost:3200 npm --prefix mobile run web -- --port 8085"
      ],
      "port": 8085
    },
    {
      "name": "maaji-mobile-sim",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd mobile && EXPO_PUBLIC_API_URL=http://localhost:3200 npx expo start --port 8086 --clear"
      ],
      "port": 8086
    }
  ]
}
