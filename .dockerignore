# Keep the build context lean and reproducible. Anything the Dockerfile needs
# must be re-added by NOT matching a rule here.

# Version control + editor state
.git
.gitignore
.vscode
.idea
.DS_Store

# Docker itself
.dockerignore
Dockerfile*

# Local dev / tooling
docker-compose*
.husky
.claude

# Build artefacts (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# Env files — never bake secrets into an image; only the contract stays.
.env
.env.*
!.env.example
# The production secrets file sits at the repo root on the VPS (deploy.sh,
# docker-compose.prod.yml env_file) and is read at RUNTIME only. It was
# copied into the builder stage by `COPY . .` (2026-11-23, found in the
# server's containerd snapshots) — never again.
prod.env
**/prod.env
*.env
!deploy/prod.env.template

# Signing keys and store credentials (mobile release, Apple, Google).
play-service-account.json
**/play-service-account.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
**/*.p8
**/*.p12
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.mobileprovision

# Project docs and non-app assets
BACKLOG.md
CLAUDE.md
AGENTS.md
ELVORIA_MENU_SPEC.md
ELVORIA_ROADMAP.md
README.md
themes images

# Dev-only DB seed
prisma/dev-roles.sql

# Local data exports — customer database dumps and upload archives. Never
# part of an image (2026-11-21: a dump was found in .next/standalone).
release
*.dump
*.tgz
# Customer uploads + resized cache: production volumes (docker-compose.prod.yml),
# never part of the image.
public/uploads
.image-cache

# The mobile app is built by EAS / Xcode, never by the server image (and
# its node_modules / ios build would bloat the context by gigabytes).
mobile
